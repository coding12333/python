import random

secret = random.randint(1,50)
attempts = 5
won = False
print("Welcome to the guessing game!")
print("I am thinking of a number between 1 and 50 and you have to guess it, are you ready?")
while attempts > 0 and not won:
    guess = int(input("Enter your guess here:   "))
    if guess == secret:
        print("Congratulations, you guessed my number correctly!")
        won = True
    else:
        attempts -= 1
        print("It's okay, try again!")
